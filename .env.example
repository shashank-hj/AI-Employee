DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_employee
REDIS_URL=redis://redis:6379/0
SECRET_KEY=changeme
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001
TOOL_REGISTRY_PORT=8002
MEMORY_PORT=8003
RAG_PORT=8004
WORKFLOW_PORT=8005
SPEECH_PORT=8006
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Service URLs ──
GATEWAY_URL=http://gateway:8000
TOOL_REGISTRY_URL=http://tool-registry:8002
MEMORY_URL=http://memory:8003
RAG_URL=http://localhost:8004
RAG_QUERY_PATH=/api/query
# Browser-reachable URL for the integrated dashboard (gateway / and /chat redirect here).
# The chat now lives inside the dashboard, so point this at your exposed orchestrator port.
DASHBOARD_PUBLIC_URL=http://localhost:8001/dashboard
RAG_HEALTH_PATH=/health
RAG_TIMEOUT=5.0

# ── LLM Provider ──
# Choose your provider: "ollama" | "sarvam" | "" (mock/offline)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_CLASSIFY_MAX_TOKENS=512
LLM_FALLBACK_INTENT=general

# ── Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120.0

# ── Sarvam AI (cloud) ──
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT=30.0
SARVAM_MAX_RETRIES=3

# ── Sarvam Speech (STT / TTS) ──
# STT models: saaras:v3 (default/recommended), saaras:v4, sarvam-1, sarvam-1-20x-hi-en-2025-03-04
SARVAM_STT_MODEL=saaras:v3
# TTS models: bulbul:v2 (default), bulbul:v3 (latest)
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_LANGUAGE=en-IN
SPEECH_URL=http://speech:8006


# Usage / Cost tracking
# Set to false to disable recording of LLM/speech/embedding usage rows.
USAGE_ENABLED=true
# Optional JSON override for the pricing table (INR). Deep-merges over defaults.
# LLM models are per-1M-tokens; speech/embed operations are per-unit rates.
# Example (official Sarvam rates):
# {"models": {"sarvam-105b": {"in": 4, "out": 16}},
#  "operations": {"tts": {"unit": "characters", "rate": 0.003},
#                 "stt": {"unit": "audio_seconds", "rate": 0.008333}}}
USAGE_PRICING={}

# ── Email (SMTP + IMAP) ──
# Set EMAIL_ENABLED=true and fill in credentials to enable email sending via SMTP
# For Gmail: enable 2FA, then generate an app password at https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_DISPLAY_NAME=AI Employee

# ── Calendar (Google Calendar API + ICS fallback) ──
# provider: auto | google | ics. auto picks Google when valid OAuth creds are
# present, otherwise falls back to .ics invites via the Gmail SMTP stack.
# Run `python -m scripts.google_calendar_auth` from the repo root to open the
# Google authorization page and print GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET /
# GOOGLE_REFRESH_TOKEN. It reads the client config from credentials.json
# (Google Cloud > OAuth client ID, type "Desktop app").
CALENDAR_ENABLED=false
CALENDAR_PROVIDER=auto
CALENDAR_TIMEZONE=Asia/Kolkata
CALENDAR_ICS_INVITES_ENABLED=true
CALENDAR_DUPLICATE_WINDOW_MINUTES=15
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
