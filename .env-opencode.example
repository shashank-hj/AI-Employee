# ── opencode as LLM engine (example) ──
# Copy this file to `.env-opencode` to enable opencode as the platform's LLM
# provider. It overrides LLM_PROVIDER and configures the opencode HTTP backend,
# keeping the main `.env` untouched.

# Prereqs: run `opencode serve` on the host (default 127.0.0.1:4096):
#   mkdir %TEMP%\opencode-engine && cd %TEMP%\opencode-engine
#   opencode serve --port 4096
#
# Docker reachability:
#   OPENCODE_BASE_URL=http://host.docker.internal:4096
# Local (non-Docker) dev:
#   OPENCODE_BASE_URL=http://localhost:4096

LLM_PROVIDER=opencode
OPENCODE_BASE_URL=http://host.docker.internal:4096
# Pin the model to keep cost/behaviour deterministic. Currently opencode-go's
# deepseek-v4-flash (cheap, tested with this provider). To use opencode's
# default instead, empty this value.
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
OPENCODE_AGENT=general
OPENCODE_MAX_TOKENS=2048
# HTTP basic auth shared with `opencode serve`. Set OPENCODE_SERVER_PASSWORD on
# the server process to the same value so the server is not unsecured.
OPENCODE_PASSWORD=
OPENCODE_USERNAME=opencode
OPENCODE_TIMEOUT=120.0

# ── RAG answer generation ──
# Enable the RAG service to synthesize a natural-language answer (with source
# document names) from retrieved chunks using the opencode engine above.
RAG_ANSWER_ENABLED=true
RAG_ANSWER_LLM=opencode
RAG_ANSWER_TOP_K=8
RAG_ANSWER_MAX_TOKENS=1024
RAG_ANSWER_TIMEOUT=120.0
